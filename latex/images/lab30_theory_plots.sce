// -------------------------------------------------------------

// -------------------------------------------------------------
clear; clc; close; mode(2);     // русские подписи OK 🪄

// === 1. Параметры элементов ==================================
R2 = 14;            // Ом
R3 = 17;            // Ом
L2 = 17e-3;         // 17 мГн
C3 = 232e-6;        // 232 мкФ

// === 2. Частотный диапазон ===================================
fvec = logspace(log10(10), log10(4000), 600);  // 600 точек
wvec = 2*%pi*fvec;                             // рад/с

// === 3. Комплексные импедансы ветвей ==========================
Z_RL = R3 + %i*wvec*L2;        // R3 + jωL2
Z_RC = R2 - %i./(wvec*C3);     // R2 – j/(ωC3)

// === 4. Эквивалентный импеданс (параллель) ====================
Zeq = (Z_RL .* Z_RC) ./ (Z_RL + Z_RC);

// === 5. Амплитудно-частотная характеристика ===================
magZ = abs(Zeq);                // |Z(f)|

// === 6. Фазо-частотная характеристика =========================
phiZ = atan(imag(Zeq), real(Zeq)) * 180/%pi;   // φ_Z(f), °

// === 7. График АЧХ ============================================
scf(1); clf();
plot(fvec, magZ, "LineWidth", 2);
gca().log_flags = "lnn";           // лог-ось X
xtitle("|Z_{экв}(f)|  —  АЧХ");
xlabel("f, Гц  (лог)");  ylabel("|Z_{экв}|, Ом");
xgrid();
xs2png(1, "Zeq_mag.png");
mprintf("PNG-файл сохранён: Zeq_mag.png\n");

// === 8. График ФЧХ ============================================
scf(2); clf();
plot(fvec, phiZ, "LineWidth", 2);
gca().log_flags = "lnn";           // лог-ось X
xtitle("φ_Z(f)  —  ФЧХ");
xlabel("f, Гц  (лог)");  ylabel("φ_Z, °");
xgrid();
xs2png(2, "Zeq_phase.png");
mprintf("PNG-файл сохранён: Zeq_phase.png\n");

// -------------------------------------------------------------
mprintf("\nСкрипт point27_freq_resp.sce успешно выполнен.\n");
