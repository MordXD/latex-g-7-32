% gost-7-32-pagination.sty - Стилевой файл для настройки нумерации страниц по ГОСТ 7-32-2017
%
% Данный стилевой файл содержит настройки для правильной
% нумерации страниц в соответствии с ГОСТ 7-32-2017.
%

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{gost-7-32-pagination}[2024/03/10 v1.0 Page numbering for GOST 7-32-2017]

% Загружаем пакет для настройки колонтитулов
\RequirePackage{fancyhdr}

% Настройка стандартной нумерации страниц
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\thepage}

% Отключение нумерации на титульной странице и содержании,
% с началом нумерации с 3-й страницы
\AtBeginDocument{
  % Убираем номера страниц для титульной страницы
  \pagestyle{empty}
  \maketitlepage % Титульная страница
  
  % Сохраняем стиль empty и для страницы с содержанием
  \tableofcontents % Содержание
  \thispagestyle{empty} % Принудительно убираем номер на странице содержания
  \newpage
  
  % Включаем нумерацию с 3-й страницы
  \pagestyle{fancy}
  
  % Устанавливаем значение счетчика страниц
  \setcounter{page}{3}
}

\endinput 