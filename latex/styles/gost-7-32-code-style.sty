% Настройка для различных языков программирования
\lstdefinestyle{pythonstyle}{
    language=Python,
    style=gost732style,
    morekeywords={self, if, else, return, try, except, raise, finally, None, True, False}
}

\lstdefinestyle{cppstyle}{
    language=C++,
    style=gost732style,
    morekeywords={nullptr, const, override, auto, constexpr}
}

\lstdefinestyle{csharpstyle}{
    language=[Sharp]C,
    style=gost732style,
    morekeywords={var, async, await, using, get, set, where, select, from, new}
}

\lstdefinestyle{javastyle}{
    language=Java,
    style=gost732style,
    morekeywords={ArrayList, StringBuilder, Override, implements, extends, null}
}

% Добавляем стиль для языка Scilab
\lstdefinelanguage{Scilab}{%
    morekeywords={function, endfunction, if, then, else, elseif, end, for, while, select, case, break, return, try, catch, clear, clf, plot, title, xlabel, ylabel, grid, legend, scf, linspace, ones, sqrt, atan, sin, cos, tan},
    sensitive=true,
    comment=[l]{//},
    morestring=[b]',
    morestring=[b]"
}

\lstdefinestyle{scilabstyle}{%
    style=gost732style,
    language=Scilab
}

% Добавляем стиль для MATLAB
\lstdefinestyle{matlabstyle}{%
    language=Matlab,
    style=gost732style
}

% Окончательная настройка стиля после загрузки всех пакетов
\AtBeginDocument{%
  % Установка стиля по умолчанию
  \lstset{style=gost732style}
  
  % Явное установление настроек рамки для кода
  \lstset{
    frame=single,
    framerule=0.4pt,
    framesep=3pt,
    xleftmargin=8pt,
    xrightmargin=8pt
  }
}

% Определение команды для оформления кода прямо в тексте
\newcommand{\code}[1]{\texttt{#1}}

% Определение окружения для алгоритмов
\newenvironment{algorithm}[1][\unskip]{%
    \begin{center}
    \begin{minipage}{0.95\textwidth}
    \begin{enumerate}
    \setlength{\itemsep}{0.5em}
}{%
    \end{enumerate}
    \end{minipage}
    \end{center}
}

% Определение команды Code для совместимости
\newenvironment{Code}{\begin{lstlisting}}{\end{lstlisting}}

% Команда для вставки кода из файла
\newcommand{\lstinputfile}[3][]{\lstinputlisting[style=#2,caption={#3},#1]}

% Команда для выбора языка по умолчанию
\newcommand{\setdefaultcodelanguage}[1]{\lstset{language=#1}}

\endinput